{
  "name": "darkstar-forge",
  "version": "1.0.0",
  "private": true,
  "description": "Darkstar Forge — editor de cartas do jogo Darkstar",
  "author": "Darkstar <dyegomiranda@users.noreply.github.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "python3 tools/serve.py 8765",
    "electron": "electron .",
    "build:appimage": "electron-builder --linux AppImage --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "build:windows": "electron-builder --win nsis --publish never",
    "build:all": "electron-builder --linux AppImage deb --win nsis --publish never",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "build": {
    "appId": "com.darkstar.forge",
    "productName": "Darkstar Forge",
    "executableName": "darkstar-forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "assets/icons/set/logo.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/set/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron@43.2.0": true
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1"
  }
}
